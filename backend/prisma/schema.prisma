datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String     @id @default(uuid())
  email                  String     @unique
  password               String     // bcrypt password hash
  fullName               String?
  name                   String?
  username               String?    @unique
  role                   String     @default("USER") // USER, ADMIN, MODERATOR, etc.
  avatar                 String?
  bio                    String?
  college                String?
  degree                 String?
  graduationYear         Int?
  currentRole            String?
  githubUrl              String?
  linkedinUrl            String?
  leetcodeUrl            String?
  codeforcesUrl          String?
  codechefUrl            String?
  gfgUrl                 String?
  portfolioUrl           String?
  
  lastLogin              DateTime?
  currentStreak          Int        @default(0)
  longestStreak          Int        @default(0)
  lastActiveDate         DateTime?
  
  completedTopics        String?    // JSON string array of completed topic IDs
  completedProblems      String?    // JSON string array of completed problem IDs
  progressData           String?    // JSON string blob for custom user state
  
  isEmailVerified        Boolean    @default(false)
  emailVerificationToken String?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  
  learningHours          Float      @default(0.0)
  xp                     Int        @default(0)
  level                  Int        @default(1)
  progress               Progress[]
  achievements           UserAchievement[]
  activities             UserActivity[]
  practiceAttempts       PracticeAttempt[]
  events                 UserEvent[]
  interviewSessions      InterviewSession[]
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

model UserEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  eventType   String   // LESSON_COMPLETED, PROBLEM_COMPLETED, VISUALIZER_USED, INTERVIEW_COMPLETED, PLAYGROUND_USED
  topic       String?
  details     String?
  timestamp   DateTime @default(now())

  @@index([userId, timestamp])
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model UserActivity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // TOPIC_OPENED, TOPIC_COMPLETED, PROBLEM_OPENED, PROBLEM_COMPLETED, VISUALIZER_USED, PRACTICE_COMPLETED, INTERVIEW_COMPLETED, ROADMAP_MILESTONE, PLAYGROUND_USED
  description String
  topicId     String?
  problemId   String?
  duration    Int      @default(0) // duration in seconds
  timestamp   DateTime @default(now())

  @@index([userId, timestamp])
}

model UserTopicCompletion {
  id          String   @id @default(uuid())
  userId      String
  topicId     String
  completedAt DateTime @default(now())

  @@unique([userId, topicId])
}

model UserProblemCompletion {
  id          String   @id @default(uuid())
  userId      String
  problemId   String
  score       Int      @default(0)
  completedAt DateTime @default(now())

  @@unique([userId, problemId])
}

model UserStreak {
  id                  String    @id @default(uuid())
  userId              String    @unique
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  activeDaysThisMonth Int       @default(0)
  activeDaysThisYear  Int       @default(0)
  totalActiveDays     Int       @default(0)
  lastActiveDate      DateTime?
  updatedAt           DateTime  @updatedAt
}

model Progress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  algorithmId   String   
  completed     Boolean  @default(false)
  score         Int      @default(0) 
  lastAccessed  DateTime @default(now())

  @@unique([userId, algorithmId])
}

model Algorithm {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  category          String
  difficulty        String
  complexity        String
  introduction      String
  intuition         String
  interviewNotes    String
  relatedTopics     String
  visualizationType String
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Question {
  id                 String   @id @default(uuid())
  title              String
  difficulty         String
  topic              String
  pattern            String
  statement          String
  hints              String
  solution           String
  expectedComplexity String
  tags               String
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RoadmapNode {
  id               String   @id @default(uuid())
  title            String
  category         String
  difficulty       String
  estimatedTime    String
  description      String
  recommendedOrder Int
  prerequisites    String
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Achievement {
  id              String   @id @default(uuid())
  title           String
  description     String
  icon            String
  xpReward        Int
  unlockCondition String
  
  users           UserAchievement[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PracticeAttempt {
  id              String   @id @default(uuid())
  userId          String?  
  user            User?    @relation(fields: [userId], references: [id])
  mode            String
  difficulty      String
  score           Int
  accuracy        Float
  completionTime  Int
  
  createdAt       DateTime @default(now())
}

model InterviewSession {
  id                   String                @id @default(uuid())
  userId               String?
  user                 User?                 @relation(fields: [userId], references: [id])
  role                 String
  difficulty           String
  interviewStyle       String
  selectedTopics       String                // JSON array of strings
  enabledFeatures      String                // JSON array of strings
  status               String                @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  turnCount            Int                   @default(0)
  maxTurns             Int                   @default(8)
  timeLimitPerQuestion Int                   @default(0) // seconds per question (0 = untimed)
  startedAt            DateTime              @default(now())
  completedAt          DateTime?
  messages             InterviewMessage[]
  evaluations          InterviewEvaluation[]
  report               InterviewReport?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId, createdAt])
}

model InterviewMessage {
  id               String           @id @default(uuid())
  sessionId        String
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequenceNumber   Int
  sender           String           // 'interviewer' | 'candidate' | 'system'
  content          String
  questionTopic    String?
  questionType     String?          // 'conceptual' | 'problem_solving' | 'follow_up' | 'behavioral'
  timeSpentSeconds Int?             // seconds candidate took to submit
  timedOut         Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([sessionId, sequenceNumber])
}

model InterviewEvaluation {
  id              String           @id @default(uuid())
  sessionId       String
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId       String?
  questionText    String?
  candidateAnswer String?
  dimension       String           // 'technicalAccuracy' | 'conceptualUnderstanding' | 'completeness' | 'communication' | 'problemSolving' | 'practicalApplication' | 'confidence' | 'timeManagement'
  score           Float            // 0 - 10 scale
  rationale       String
  evidence        String
  createdAt       DateTime         @default(now())

  @@index([sessionId, dimension])
}

model InterviewReport {
  id                  String           @id @default(uuid())
  sessionId           String           @unique
  session             InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore        Float?           // score out of 100
  performanceGrade    String?          // 'Excellent' | 'Very Good' | 'Good' | 'Average' | 'Needs Improvement'
  summary             String
  strengths           String           // JSON string array
  improvementAreas    String           // JSON string array
  dimensionScores     String           // JSON object string with 10-point scale parameters
  topicScores         String?          // JSON object string for topic-wise breakdowns
  questionReviews     String           // JSON array string
  recommendations     String           // JSON string array
  actionablePlan      String?          // JSON array string with priority levels
  interviewerFeedback String?          // Final professional interviewer remarks
  createdAt           DateTime         @default(now())
}

